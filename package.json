{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "build:pages": "vite build --outDir docs && cp docs/index.html docs/404.html",
    "preview:pages": "vite preview --outDir docs",
    "start": "node server.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "review": "tsx scripts/review_code.ts",
    "clean-code": "tsx scripts/clean_dead_code.ts",
    "update-docs": "tsx scripts/update_docs.ts",
    "pipeline": "npm run clean-code && npm run lint && npm run test && npm run review && npm run update-docs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@mediapipe/tasks-vision": "^1.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
